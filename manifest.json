  <script>
    // ==========================================
    // CONFIGURACIÓN DE SUPABASE (REEMPLAZA ESTOS VALORES CON LOS TUYOS)
    // ==========================================
    const supabaseUrl = 'https://lrvitaprtpppqcwhbjba.supabase.co'; 
    const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxydml0YXBydHBwcHFjd2hiamJhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk4NTQ2MzQsImV4cCI6MjEwNTQzMDYzNH0.pkw8hR7BwkZa65h3phhVqDG_3-qTdPhZnn5PqPgJHEA'; 
    const supabase = window.supabase.createClient(supabaseUrl, supabaseKey);

    let usuarioActual = null;
    let todosLosRegistros = [], pendientesTecnicoActual = [], historicoTecnicoActual = [], directorioTecnicos = [];
    let archivoFotoSeleccionado = null, base64Compresion = null, chartGauge = null, chartBar = null;

    // --- FUNCIÓN DE LOGIN CON SUPABASE ---
    async function ejecutarLogin() {
      const u = document.getElementById('input-user').value.trim().toLowerCase();
      const p = document.getElementById('input-pass').value.trim();
      const alertBox = document.getElementById('login-alert');
      const btnLogin = document.getElementById('btn-login-submit');

      if (!u || !p) return alert("Ingrese usuario y contraseña");

      btnLogin.disabled = true;
      btnLogin.innerText = "Verificando...";

      try {
        const { data, error } = await supabase
          .from('usuarios')
          .select('*')
          .eq('usuario', u)
          .eq('password', p)
          .single();

        btnLogin.disabled = false;
        btnLogin.innerText = "Iniciar Sesión";

        if (data && !error) {
          data.esTecnico = data.rol && data.rol.toLowerCase().includes('tec');
          usuarioActual = data;
          localStorage.setItem("nps_user_profile", JSON.stringify(data));
          iniciarVistaSegunRol(data);
        } else {
          if (alertBox) {
            alertBox.innerText = "Credenciales incorrectas o usuario no encontrado";
            alertBox.classList.remove('hidden');
          }
        }
      } catch(e) {
        btnLogin.disabled = false;
        btnLogin.innerText = "Iniciar Sesión";
        if (alertBox) {
          alertBox.innerText = "Error de conexión con la base de datos.";
          alertBox.classList.remove('hidden');
        }
      }
    }

    // --- CARGAR TAREAS PENDIENTES CON SUPABASE ---
    async function cargarPendientesTecnico() {
      mostrarSyncStatus(true);
      try {
        const { data, error } = await supabase
          .from('gestiones')
          .select('*')
          .eq('tecnico_asignado', usuarioActual.nombre)
          .in('estado', ['Pendiente', '']);

        if (data && !error) {
          pendientesTecnicoActual = data.map(item => ({
             fila: item.id, // ID Único de Supabase
             idGestion: item.id_gestion,
             codigoCliente: item.codigo_cliente,
             nombreUsuario: item.nombre_usuario,
             tecnicoAsignado: item.tecnico_asignado,
             fechaAsignacion: item.fecha_asignacion,
             estado: 'Pendiente',
             numeroOT: item.numero_ot,
             telefono: item.telefono
          }));
          localStorage.setItem(`cache_pendientes_${usuarioActual.usuario}`, JSON.stringify(pendientesTecnicoActual));
          renderizarPendientesTecnicoUI();
        }
      } catch(e) { console.error(e); }
      mostrarSyncStatus(false);
    }

    // --- CARGAR HISTORIAL CON SUPABASE ---
    async function cargarHistoricoTecnico() {
      try {
        const { data, error } = await supabase
          .from('gestiones')
          .select('*')
          .eq('tecnico_asignado', usuarioActual.nombre)
          .neq('estado', 'Pendiente')
          .neq('estado', '');

        if (data && !error) {
          historicoTecnicoActual = data.map(item => ({
             fila: item.id,
             idGestion: item.id_gestion,
             codigoCliente: item.codigo_cliente,
             nombreUsuario: item.nombre_usuario,
             numeroOT: item.numero_ot,
             estado: item.estado,
             evidencia: item.evidencia_url
          }));
          localStorage.setItem(`cache_historico_${usuarioActual.usuario}`, JSON.stringify(historicoTecnicoActual));
          renderizarHistoricoTecnicoUI();
        }
      } catch(e) {}
    }

    // --- GUARDAR FORMULARIO, SUBIR FOTO AL BUCKET Y ACTUALIZAR BD ---
    async function guardarFormulario() {
      const filaId = document.getElementById('modal-fila').value;
      const numeroOT = document.getElementById('modal-ot').value.trim();
      const codigoCliente = document.getElementById('modal-codigo').value.trim();
      const estado = document.getElementById('modal-estado').value;
      const obs = document.getElementById('modal-observacion').value.trim();

      if (!base64Compresion && !archivoFotoSeleccionado) {
        alert("⚠ DEBE ADJUNTAR UNA FOTO DE RESPALDO OBLIGATORIAMENTE.");
        return;
      }

      if (archivoFotoSeleccionado && !base64Compresion) {
        alert("⏳ La foto aún se está optimizando. Espere un segundo y presione Guardar.");
        return;
      }

      const btnGuardar = document.getElementById('btn-guardar');
      btnGuardar.disabled = true;
      btnGuardar.innerText = "Subiendo archivo...";

      try {
        let urlFoto = "";
        
        // CORRECCIÓN DE ALMACENAMIENTO: Transformar base64 a Blob y subir a Supabase Storage
        if (base64Compresion) {
           const resBlob = await fetch(base64Compresion);
           const blob = await resBlob.blob();
           const nombreArchivo = `${numeroOT || codigoCliente}_${Date.now()}.jpg`;

           const { data: uploadData, error: uploadErr } = await supabase.storage
             .from('evidencias_nps')
             .upload(`fotos/${nombreArchivo}`, blob, { contentType: 'image/jpeg' });

           if (!uploadErr) {
              const { data: publicUrlData } = supabase.storage.from('evidencias_nps').getPublicUrl(`fotos/${nombreArchivo}`);
              urlFoto = publicUrlData.publicUrl;
           }
        }

        // Actualizar fila en Base de Datos Supabase
        const { data, error } = await supabase
          .from('gestiones')
          .update({
             estado: estado,
             observacion: obs,
             evidencia_url: urlFoto,
             fecha_gestion: new Date().toISOString()
          })
          .eq('id', filaId);

        if (error) throw error;

        btnGuardar.disabled = false;
        btnGuardar.innerText = "Guardar Gestión";
        
        // CORRECCIÓN FALSO GUARDADO: Solo quitar de la UI si no hubo errores en Supabase
        pendientesTecnicoActual = pendientesTecnicoActual.filter(item => item.fila != filaId);
        renderizarPendientesTecnicoUI();
        
        alert("¡Gestión y foto guardadas con éxito!");
        ocultarModalBS('modalGestion');
        
        archivoFotoSeleccionado = null;
        base64Compresion = null;
        cargarHistoricoTecnico();

      } catch(e) {
        btnGuardar.disabled = false;
        btnGuardar.innerText = "Guardar Gestión";
        alert("Error de conexión al guardar. Intente de nuevo.");
      }
    }

    // --- CARGAR DATOS DASHBOARD ADMIN CON SUPABASE ---
    async function cargarDashboard(forzarNube = false) {
      // (Versión simplificada de la carga de Admin, puedes luego añadir fechas y filtros complejos)
      try {
        const { data, error } = await supabase.from('gestiones').select('*');
        if (data && !error) {
           const kpis = { gestionados: 0, pendientes: 0, conflictivos: 0 };
           const registros = [];
           data.forEach(item => {
              if (item.estado === 'Gestionado') kpis.gestionados++;
              else if (item.estado === 'Pendiente' || item.estado === '') kpis.pendientes++;
              else kpis.conflictivos++;
              
              registros.push({
                 idGestion: item.id_gestion, codigoCliente: item.codigo_cliente,
                 nombreUsuario: item.nombre_usuario, tecnico: item.tecnico_asignado,
                 estado: item.estado || "Pendiente", numeroOT: item.numero_ot
              });
           });
           procesarYRenderizarDashboard({ kpis: kpis, registros: registros, tecnicos: [] });
        }
      } catch(e) { console.error(e); }
    }

    // --- CORRECCIÓN DE SEGURIDAD EN WHATSAPP ---
    function generarUrlWhatsApp(telefono, codigoCliente, nombreUsuario, nombreTecnico) {
      let numLimpio = telefono.toString().replace(/[^0-9]/g, '');
      let horaActual = new Date().getHours();
      let saludoHora = "Estimado cliente, buenas tardes. 👋";

      if (horaActual >= 0 && horaActual < 12) saludoHora = "Estimado cliente, buenos días. ☀️";
      else if (horaActual >= 12 && horaActual < 19) saludoHora = "Estimado cliente, buenas tardes. 👋";
      else saludoHora = "Estimado cliente, buenas noches. 🌙";

      // .trim() agregado para limpiar variables
      let tecNombre = (usuarioActual && usuarioActual.nombre) ? usuarioActual.nombre.trim() : (nombreTecnico || 'Servicio Técnico').trim();
      let clienteNombre = (nombreUsuario || 'Estimado Cliente').trim();
      let codCliente = (codigoCliente || 'N/A').trim();

      let mensajeWs = `${saludoHora}\n\nLe escribo de parte del Servicio Técnico Tigo. Recientemente realicé un trabajo correspondiente a su código *${codCliente}* (${clienteNombre}).\n\nMi nombre es *${tecNombre}*. Quería consultarle si pudo completar la encuesta de satisfacción que le mencioné al finalizar mi trabajo.\n\nEn caso de que aún no la haya respondido, le agradecería mucho si pudiera tomarse un momento para completarla, si hice un buen trabajo por favor un *10* 😁. Su calificación es muy importante para mí.\n\n📲 *GUÍA PARA INGRESAR Y LLENAR LA ENCUESTA:*\n1. Ingrese a sus Mensajes de Texto (SMS).\n2. Ubique la cuenta TIGO o el número 2820.\n3. Abra el link, marque "No soy un robot" y califique con 10.\n\nMUCHAS GRACIAS POR SU TIEMPO! 🙌`;

      return `https://wa.me/591${numLimpio}?text=${encodeURIComponent(mensajeWs)}`;
    }

    // =====================================
    // FUNCIONES UI Y UTILIDADES ESTÁNDAR
    // =====================================
    
    function togglePasswordVisibility() {
      const inputPass = document.getElementById('input-pass');
      const eyeIcon = document.getElementById('eye-icon');
      if (inputPass.type === 'password') {
        inputPass.type = 'text'; eyeIcon.className = 'bi bi-eye-slash';
      } else {
        inputPass.type = 'password'; eyeIcon.className = 'bi bi-eye';
      }
    }

    async function autenticarConHuella() {
      const perfilGuardado = localStorage.getItem("nps_user_profile");
      if (perfilGuardado) {
        usuarioActual = JSON.parse(perfilGuardado);
        iniciarVistaSegunRol(usuarioActual);
      } else { alert("Inicie sesión con usuario y contraseña primero."); }
    }

    function cambiarPestana(pestana) {
      document.getElementById('tab-tecnicos-btn').classList.remove('active');
      document.getElementById('tab-general-btn').classList.remove('active');
      if (pestana === 'tecnicos') {
        document.getElementById('tab-tecnicos-btn').classList.add('active');
        document.getElementById('sec-tecnicos').classList.remove('hidden');
        document.getElementById('sec-general').classList.add('hidden');
      } else {
        document.getElementById('tab-general-btn').classList.add('active');
        document.getElementById('sec-tecnicos').classList.add('hidden');
        document.getElementById('sec-general').classList.remove('hidden');
      }
    }

    function navegarBottom(seccion) {
      document.querySelectorAll('.nav-item-btn').forEach(btn => btn.classList.remove('active'));
      document.getElementById('bnav-' + seccion).classList.add('active');
      const ids = ['sec-tec-inicio', 'sec-tec-pendientes', 'sec-tec-historico', 'sec-tec-perfil'];
      ids.forEach(id => document.getElementById(id).classList.add('hidden'));

      const secEl = document.getElementById('sec-tec-' + seccion);
      if (secEl) {
        secEl.classList.remove('hidden');
        secEl.classList.add('fade-in-view');
      }
      if (seccion === 'inicio' || seccion === 'pendientes') {
        renderizarPendientesTecnicoUI(); cargarPendientesTecnico();
      } else if (seccion === 'historico') {
        renderizarHistoricoTecnicoUI(); cargarHistoricoTecnico();
      }
    }

    function abrirModalBS(elementId) {
      const modalEl = document.getElementById(elementId);
      if (modalEl) {
        let instance = bootstrap.Modal.getInstance(modalEl);
        if (!instance) instance = new bootstrap.Modal(modalEl);
        instance.show();
      }
    }

    function ocultarModalBS(elementId) {
      const modalEl = document.getElementById(elementId);
      if (modalEl) {
        let instance = bootstrap.Modal.getInstance(modalEl);
        if (instance) instance.hide();
      }
    }

    function abrirModalGuiaImagen() { abrirModalBS('modalGuiaSms'); }

    function actualizarSaludoHora() {
      const now = new Date();
      const hora = now.getHours();
      const mins = now.getMinutes().toString().padStart(2, '0');
      document.getElementById('label-reloj-hora').innerText = `${hora}:${mins}`;

      let saludo = "¡Buenas noches!";
      if (hora >= 5 && hora < 12) saludo = "¡Buenos días!";
      else if (hora >= 12 && hora < 19) saludo = "¡Buenas tardes!";

      const nombreTec = usuarioActual ? usuarioActual.nombre.split(' ')[0] : '';
      if(document.getElementById('label-saludo-animado')) {
        document.getElementById('label-saludo-animado').innerText = `${saludo} ${nombreTec} 👋`;
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      const perfilGuardado = localStorage.getItem("nps_user_profile");
      if (perfilGuardado) {
        try {
          usuarioActual = JSON.parse(perfilGuardado);
          iniciarVistaSegunRol(usuarioActual);
        } catch(e) { cerrarSesion(); }
      }
      setInterval(actualizarSaludoHora, 30000);
    });

    function iniciarVistaSegunRol(res) {
      document.getElementById('view-login').classList.add('hidden');
      const esRolTecnico = res.esTecnico || (res.rol && res.rol.toLowerCase().includes('tec'));

      if (esRolTecnico) {
        document.getElementById('view-tecnico').classList.remove('hidden');
        document.getElementById('view-admin').classList.add('hidden');
        document.getElementById('app-bottom-nav').classList.remove('hidden');

        document.getElementById('label-nombre-tec').innerText = res.nombre || 'Técnico';
        document.getElementById('perfil-nombre').innerText = res.nombre || 'Técnico';
        document.getElementById('perfil-correo').innerText = res.usuario || '';

        actualizarSaludoHora();
        navegarBottom('inicio');
        cargarPendientesTecnico();
        cargarHistoricoTecnico();
      } else {
        document.getElementById('view-admin').classList.remove('hidden');
        document.getElementById('view-tecnico').classList.add('hidden');
        document.getElementById('app-bottom-nav').classList.add('hidden');

        let areaTexto = res.area || "Encargado Nacional";
        let depTexto = res.departamento || "TODOS";
        document.getElementById('admin-header-titulo').innerText = `${res.nombre} (${res.rol})`;
        document.getElementById('admin-header-region').innerText = `ÁREA: ${areaTexto.toUpperCase()} | DEP: ${depTexto.toUpperCase()}`;

        cargarDashboard();
      }
    }

    function mostrarSyncStatus(sincronizando) {
      const lbl = document.getElementById('label-sync-status');
      const sp = document.getElementById('icon-sync-spinner');
      if (!lbl || !sp) return;
      if (sincronizando) {
        lbl.innerText = "Sincronizando..."; sp.classList.remove('hidden');
      } else {
        lbl.innerText = "Sincronizado"; sp.classList.add('hidden');
      }
    }

    function renderizarPendientesTecnicoUI() {
      const contenedor = document.getElementById('lista-pendientes');
      if (!contenedor) return;

      document.getElementById('tec-kpi-total').innerText = pendientesTecnicoActual.length;
      document.getElementById('tec-kpi-pendientes').innerText = pendientesTecnicoActual.length;
      
      const badgeEl = document.getElementById('bnav-badge-count');
      if (pendientesTecnicoActual.length > 0) {
        badgeEl.innerText = pendientesTecnicoActual.length;
        badgeEl.classList.remove('hidden');
      } else { badgeEl.classList.add('hidden'); }

      contenedor.innerHTML = '';

      if (!pendientesTecnicoActual || pendientesTecnicoActual.length === 0) {
        contenedor.innerHTML = '<div class="alert alert-dark border-secondary text-secondary text-center small py-3 col-12">No tienes órdenes pendientes.</div>';
        return;
      }

      pendientesTecnicoActual.forEach((item, index) => {
        let codigo = item.codigoCliente || item.idGestion || 'S/C';
        let usuario = item.nombreUsuario || 'Cliente General';
        let telefono = item.telefono || 'Sin Teléfono';
        let otNum = item.numeroOT || 'Sin OT';
        
        let telLlamar = (telefono && telefono !== 'Sin Teléfono') ? 
          `<a href="tel:${telefono}" class="btn btn-sm btn-outline-warning fw-bold flex-fill"><i class="bi bi-telephone-fill me-1"></i>Llamar</a>` : '';
        let urlWs = (telefono && telefono !== 'Sin Teléfono') ? generarUrlWhatsApp(telefono, codigo, usuario, item.tecnicoAsignado) : '#';
        let btnWs = (telefono && telefono !== 'Sin Teléfono') ? 
          `<a href="${urlWs}" target="_blank" class="btn btn-sm btn-success fw-bold flex-fill"><i class="bi bi-whatsapp me-1"></i>WhatsApp</a>` : '';

        contenedor.innerHTML += `
          <div class="order-card mb-3 fade-in-view">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge-subtle badge-pending">Pendiente</span>
                <span class="text-info fw-semibold" style="font-size: 0.72rem;"><i class="bi bi-hdd-network me-1"></i>HFC</span>
              </div>
              <h6 class="fw-bold text-white m-0">Cliente #${codigo}</h6>
              <small class="text-secondary d-block mb-2" style="font-size: 0.75rem;">${usuario} • OT #${otNum}</small>
            </div>
            <div class="d-flex gap-2 mt-2">
              ${telLlamar} ${btnWs}
            </div>
            <div class="d-flex gap-2 mt-2 border-top border-secondary border-opacity-25 pt-2">
              <button class="btn btn-sm btn-primary flex-fill fw-bold py-2" onclick="abrirModal('${item.fila}', '${otNum}', '${codigo}')"><i class="bi bi-check2-circle me-1"></i> Gestionar</button>
            </div>
          </div>`;
      });
    }

    function renderizarHistoricoTecnicoUI() {
      const contenedor = document.getElementById('lista-historico-tecnico');
      if (!contenedor) return;

      document.getElementById('tec-kpi-gestionadas').innerText = historicoTecnicoActual.length;
      contenedor.innerHTML = '';

      if (!historicoTecnicoActual || historicoTecnicoActual.length === 0) {
        contenedor.innerHTML = '<div class="alert alert-dark border-secondary text-secondary text-center small py-3 col-12">No tienes gestiones en tu histórico.</div>';
        return;
      }

      historicoTecnicoActual.forEach((r, index) => {
        let isConflict = r.estado === 'UU conflictivo' || r.estado === 'Conflictivo';
        let badgeStyle = r.estado === 'Gestionado' ? 'badge-done' : (isConflict ? 'badge-danger' : 'badge-expired');
        let tieneEvidencia = r.evidencia && r.evidencia.length > 5;

        contenedor.innerHTML += `
          <div class="order-card mb-3 fade-in-view ${isConflict ? 'conflictive' : ''}">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="badge-subtle ${badgeStyle}">${r.estado}</span>
                <small class="text-secondary" style="font-size: 0.72rem;">OT: ${r.numeroOT || 'S/N'}</small>
              </div>
              <h6 class="fw-bold text-white m-0">Cliente #${r.codigoCliente || 'S/C'}</h6>
              <small class="text-secondary d-block mb-2" style="font-size: 0.75rem;">${r.nombreUsuario || 'Cliente'}</small>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-25">
              ${tieneEvidencia ? `<button class="btn btn-xs btn-outline-success p-1 px-3 small fw-bold" onclick="verFotoModal('${r.evidencia}')"><i class="bi bi-image me-1"></i>Ver Evidencia</button>` : '<span class="text-secondary small">Sin Foto</span>'}
            </div>
          </div>`;
      });
    }

    function procesarYRenderizarDashboard(res) {
      if (!res || !res.kpis) return;
      const tot = res.kpis.gestionados + res.kpis.pendientes + res.kpis.conflictivos;
      document.getElementById('kpi-total').innerText = tot;
      document.getElementById('kpi-gestionados').innerText = res.kpis.gestionados;
      document.getElementById('kpi-pendientes').innerText = res.kpis.pendientes;
      const pctCobertura = tot > 0 ? Math.round((res.kpis.gestionados / tot) * 100) : 0;
      document.getElementById('kpi-pct-prom').innerText = pctCobertura + "%";
    }

    function abrirModal(fila, numeroOT, codigoCliente) {
      document.getElementById('modal-fila').value = fila; // Esto ahora es el UUID real de Supabase
      document.getElementById('modal-ot').value = numeroOT || '';
      document.getElementById('modal-codigo').value = codigoCliente || '';
      document.getElementById('modal-estado').value = 'Gestionado';
      document.getElementById('modal-observacion').value = '';
      archivoFotoSeleccionado = null;
      base64Compresion = null;

      const btnG = document.getElementById('btn-guardar');
      btnG.disabled = false;
      btnG.innerText = "Guardar Gestión";

      const lbl = document.getElementById('label-archivo-elegido');
      lbl.className = "text-danger small fw-bold text-center";
      lbl.innerText = "⚠ Falta adjuntar foto de respaldo";

      document.getElementById('modal-foto-camara').value = '';
      document.getElementById('modal-foto-galeria').value = '';
      abrirModalBS('modalGestion');
    }

    function procesarFotoSeleccionada(input) {
      if (input.files && input.files[0]) {
        archivoFotoSeleccionado = input.files[0];
        base64Compresion = null;
        
        const lbl = document.getElementById('label-archivo-elegido');
        const btnG = document.getElementById('btn-guardar');

        btnG.disabled = true;
        btnG.innerText = "⏳ Procesando foto...";
        lbl.className = "text-warning small fw-bold text-center";
        lbl.innerText = "⏳ Optimizando imagen de respaldo...";

        convertirYComprimirFoto(archivoFotoSeleccionado).then(b64 => {
          base64Compresion = b64;
          btnG.disabled = false;
          btnG.innerText = "Guardar Gestión";
          lbl.className = "text-success small fw-bold text-center";
          lbl.innerText = "✓ Respaldo fotográfico adjuntado correctamente";
        }).catch(err => {
          btnG.disabled = false;
          btnG.innerText = "Guardar Gestión";
          lbl.className = "text-danger small fw-bold text-center";
          lbl.innerText = "Error al optimizar la imagen.";
        });
      }
    }

    function convertirYComprimirFoto(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = new Image();
          img.onload = function() {
            const canvas = document.createElement('canvas');
            let maxDimension = 800;
            let width = img.width;
            let height = img.height;
            if (width > height) {
              if (width > maxDimension) { height = Math.round((height * maxDimension) / width); width = maxDimension; }
            } else {
              if (height > maxDimension) { width = Math.round((width * maxDimension) / height); height = maxDimension; }
            }
            canvas.width = width; canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            resolve(canvas.toDataURL('image/jpeg', 0.50));
          };
          img.onerror = reject; img.src = e.target.result;
        };
        reader.onerror = reject; reader.readAsDataURL(file);
      });
    }

    function verFotoModal(urlSupabase) {
      if (!urlSupabase) return alert("La evidencia fotográfica no se encuentra disponible.");
      const imgElement = document.getElementById('visor-img');
      imgElement.src = urlSupabase;
      imgElement.classList.remove('hidden');
      abrirModalBS('modalVisorFoto');
    }

    function cerrarSesion() {
      localStorage.removeItem("nps_user_profile");
      location.reload();
    }
  </script>
</body>
</html>
